rules_version = '2';

// =====================================================================
//  Правила безопасности Firestore для шаблона интерактивного курса.
//
//  Главные принципы:
//   1. Роль «преподаватель» = существование документа teachers/{uid}.
//      Создать его можно ТОЛЬКО через консоль Firebase (write: if false).
//   2. Контент юнита (unitContent) студент читает, только если юнит
//      открыт для ЕГО группы (groups/{gid}.openUnits).
//   3. Ключи (answerKeys) студент не может прочитать НИКОГДА.
//      Проверку выполняет браузер преподавателя и записывает итог в results.
//   4. Свой результат (results) студент видит только после того, как
//      преподаватель включил проверку (groups/{gid}.releasedUnits).
//   5. Студент пишет только свой черновик и только пока юнит открыт,
//      работа не сдана и проверка не включена.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- вспомогательные функции ----------
    function signedIn() {
      return request.auth != null;
    }
    function docPath(coll, id) {
      return /databases/$(database)/documents/$(coll)/$(id);
    }
    function isTeacher() {
      return signedIn() && exists(docPath('teachers', request.auth.uid));
    }
    function myProfile() {
      return get(docPath('users', request.auth.uid)).data;
    }
    function myGroupId() {
      return myProfile().groupId;
    }
    function groupData(gid) {
      return get(docPath('groups', gid)).data;
    }
    function unitOpenForMe(unitId) {
      return signedIn()
        && exists(docPath('users', request.auth.uid))
        && unitId in groupData(myGroupId()).openUnits;
    }
    function unitReleasedFor(gid, unitId) {
      return unitId in groupData(gid).releasedUnits;
    }
    // id документов submissions/results: "<unitId>__<uid>"
    function ownsId(docId) {
      return signedIn() && docId.matches('^[A-Za-z0-9_-]+__' + request.auth.uid + '$');
    }

    // ---------- роли ----------
    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;               // только через консоль Firebase
    }

    // ---------- профили студентов ----------
    match /users/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);

      // Регистрация: студент сам создаёт профиль, указав код группы.
      // Поля role нет вообще — роль определяется коллекцией teachers.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'groupId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.groupId is string
        && exists(docPath('groups', request.resource.data.groupId))
        && request.resource.data.createdAt == request.time;

      // Студент может поменять только имя; группу меняет преподаватель.
      allow update: if
        (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100)
        || (isTeacher()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId', 'name'])
          && exists(docPath('groups', request.resource.data.groupId)));

      allow delete: if isTeacher();
    }

    // ---------- группы и доступ к юнитам ----------
    // { name, openUnits: [unitId], releasedUnits: [unitId] }
    match /groups/{gid} {
      allow read: if isTeacher() || (signedIn() && myGroupId() == gid);
      allow write: if isTeacher();
    }

    // ---------- оглавление курса (видно всем вошедшим) ----------
    match /units/{unitId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // ---------- тексты и задания юнита (БЕЗ ключей) ----------
    match /unitContent/{unitId} {
      allow read: if isTeacher() || unitOpenForMe(unitId);
      allow write: if isTeacher();
    }

    // ---------- ключи и заметки преподавателя ----------
    match /answerKeys/{unitId} {
      allow read, write: if isTeacher();
    }

    // ---------- ответы студентов (черновик / сдано) ----------
    // id = "<unitId>__<uid>"
    match /submissions/{subId} {
      function validStudentDoc(d) {
        return d.keys().hasOnly(['uid', 'groupId', 'unitId', 'answers', 'status', 'updatedAt', 'submittedAt'])
          && d.uid == request.auth.uid
          && d.groupId == myGroupId()
          && subId == d.unitId + '__' + d.uid
          && d.answers is map
          && d.status in ['draft', 'submitted']
          && d.updatedAt == request.time
          && (!('submittedAt' in d) || d.submittedAt == request.time);
      }
      function studentCanWrite(unitId) {
        return unitOpenForMe(unitId) && !unitReleasedFor(myGroupId(), unitId);
      }

      allow read: if isTeacher() || ownsId(subId);

      allow create: if signedIn()
        && validStudentDoc(request.resource.data)
        && studentCanWrite(request.resource.data.unitId);

      allow update: if
        (signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'draft'           // сданную работу менять нельзя
          && validStudentDoc(request.resource.data)
          && request.resource.data.unitId == resource.data.unitId
          && studentCanWrite(resource.data.unitId))
        || (isTeacher()                                 // «вернуть на доработку»
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if isTeacher();
    }

    // ---------- результаты проверки ----------
    // id = "<unitId>__<uid>"; пишет только преподаватель.
    match /results/{rid} {
      allow read: if isTeacher()
        || (ownsId(rid)
            && (resource == null
                || unitReleasedFor(resource.data.groupId, resource.data.unitId)));
      allow write: if isTeacher();
    }
  }
}
